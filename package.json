{
  "name": "sundayrec",
  "private": true,
  "version": "0.17.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "predev": "node scripts/fetch-ffmpeg.mjs",
    "dev": "vite",
    "pretauri": "node scripts/fetch-ffmpeg.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all --check",
    "bindings": "node scripts/clean-bindings.mjs && cargo test export_bindings --workspace && node scripts/fix-bindings-imports.mjs && node scripts/sync-bindings.mjs",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "version-sync": "node scripts/check-version-sync.mjs",
    "reachability": "node scripts/check-command-reachability.mjs",
    "smoke-verified": "node scripts/check-smoke-verified.mjs",
    "reachability:write-baseline": "node scripts/check-command-reachability.mjs --write-baseline",
    "bindings:check": "npm run bindings && git diff --quiet -- legacy/bindings || (echo 'ts-rs bindings are stale — run npm run bindings and commit legacy/bindings' && exit 1)",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run version-sync && npm run i18n-keys && npm run i18n-keys:unused && npm run i18n-hardcoded-tsx && npm run i18n-plurals && npm run css-tokens && npm run smoke-verified && npm run fmt:rust:check && npm run lint:rust && npm run test:rust && npm run bindings:check && npm run reachability",
    "ci": "bash scripts/ci-local.sh",
    "prepare": "husky",
    "i18n-keys": "node scripts/check-i18n-keys.mjs",
    "i18n-keys:unused": "node scripts/check-i18n-keys.mjs --unused",
    "i18n-hardcoded-tsx": "node scripts/check-i18n-hardcoded-tsx.mjs",
    "css-tokens": "node scripts/check-app-css-tokens.mjs",
    "i18n-plurals": "node scripts/check-i18n-plurals.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,css,json,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
