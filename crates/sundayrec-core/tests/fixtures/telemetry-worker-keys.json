{
  "_comment": "Kopi av Workerens godkjente nøkler (sunday-telemetry src/schema.ts). Én liste per objekt i pakken: 'required' = må sendes, 'optional' = kan mangle. Kontrolleres av telemetry.rs::every_client_key_is_known_to_the_worker. Worker-PR-en som endrer en liste MÅ endre denne filen i samme runde, og omvendt. counterNames = COUNTER_NAMES (verdier, ikke nøkler): hver CounterName i klienten må stå her.",
  "source": "sunday-telemetry origin/main + PR #20 (nativeXruns valgfri) + PR #21 (video.frames_dropped)",
  "payload": {
    "required": [
      "schema",
      "consentVersion",
      "installId",
      "builtAt",
      "appVersion",
      "os",
      "arch",
      "language",
      "settings",
      "counters",
      "crashes",
      "quality",
      "findings",
      "wakeFailures"
    ],
    "optional": ["corrections", "companionOutcomes"]
  },
  "settings": {
    "required": [
      "channels",
      "sampleRateMode",
      "sampleRate",
      "format",
      "bitrateKbps",
      "filenamePattern",
      "inputVolume",
      "videoEnabled",
      "stopOnSilence",
      "silenceThreshold",
      "splitMinutes",
      "autoDeleteDays",
      "trimSilence",
      "prerollEnabled",
      "showLiveLevels",
      "classicFfmpegAudio",
      "classicDirectshow",
      "autoUpdate",
      "launchAtLogin",
      "wakeFromSleep",
      "slotCount",
      "specialCount"
    ],
    "optional": []
  },
  "counters": {
    "required": ["name", "value"],
    "optional": []
  },
  "crashes": {
    "required": [
      "kind",
      "at",
      "appVersion",
      "os",
      "message",
      "location",
      "task",
      "backtracePresent"
    ],
    "optional": []
  },
  "quality": {
    "required": [
      "at",
      "durationSec",
      "expectedSec",
      "measuredSec",
      "lossPct",
      "gapSec",
      "drops",
      "dups",
      "xruns",
      "levelsDropped",
      "captureDropLines",
      "msgsDropped",
      "ringOverrunSamples",
      "exitOk",
      "verdict",
      "reasons"
    ],
    "optional": ["nativeXruns"]
  },
  "findings": {
    "required": ["code", "severity"],
    "optional": []
  },
  "wakeFailures": {
    "required": ["kind", "at", "reason", "deltaSec"],
    "optional": []
  },
  "corrections": {
    "required": ["signal", "direction", "band", "count"],
    "optional": []
  },
  "counterNames": {
    "names": [
      "recording.started.manual",
      "recording.started.scheduled",
      "recording.stopped",
      "recording.preroll.started",
      "recording.selftest",
      "editor.opened",
      "editor.export.mp3",
      "editor.export.wav",
      "editor.export.flac",
      "editor.export.video",
      "editor.export.other",
      "editor.master.applied",
      "editor.chapters.detected",
      "transcribe.run",
      "companion.build",
      "review.published",
      "review.discarded",
      "publish.feed.generated",
      "trash.moved",
      "trash.restored",
      "streaming.started",
      "diagnose.run",
      "update.installed",
      "cloud.upload.ok",
      "editor.publish.soundcloud",
      "editor.publish.youtube",
      "editor.publish.spotify",
      "editor.publish.custom",
      "appdata.move.moved",
      "appdata.move.fallback",
      "appdata.move.already",
      "appdata.move.fresh",
      "video.frames_dropped"
    ]
  }
}
